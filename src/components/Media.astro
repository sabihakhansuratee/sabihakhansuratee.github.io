---
// The one place image handling lives. Content frontmatter stores image
// fields as plain path strings relative to src/assets/media/ (e.g.
// "gallery/foo.jpg") rather than Astro's image() schema helper, because real
// images live in one shared folder decoupled from where each content entry's
// markdown file happens to sit — this is what lets a Pages CMS upload and a
// hand-placed file resolve exactly the same way. This component is what
// turns that string back into an optimised, responsive image.
import { Picture } from 'astro:assets';

interface Props {
  path: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /**
   * Use for a fixed-size thumbnail (e.g. a row of images sharing one exact
   * height, like a horizontal strip) instead of a fluid, viewport-relative
   * image. Renders at exactly this pixel height, with width computed from
   * the source's real aspect ratio — explicit pixels, not `width: auto`.
   * Combining `sizes`-based responsive width selection with flexbox
   * auto-width-from-aspect-ratio does not reliably size correctly, so this
   * path avoids that combination entirely rather than fighting it in CSS.
   */
  height?: number;
}

const {
  path,
  alt,
  class: className,
  widths = [400, 800, 1200, 1600, 2000],
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  height: fixedHeight,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/media/**/*.{jpeg,jpg,png,webp,avif}'
);

// Pages CMS (and possibly a human editing frontmatter by hand) may write this
// path with a leading slash, treating it as root-relative the way a normal
// public/ asset URL would be — strip it so both conventions resolve the same.
const normalizedPath = path.replace(/^\/+/, '');
const key = `/src/assets/media/${normalizedPath}`;

if (!images[key]) {
  throw new Error(
    `Media not found: "${path}" (looked for ${key}). Check the path in the content frontmatter against the actual filename in src/assets/media/.`
  );
}

const image = await images[key]();

// Never request a width larger than the source actually is — Astro's image
// service can't (and shouldn't) upscale.
const safeWidths = widths.filter((w) => w <= image.default.width);
const effectiveWidths = safeWidths.length > 0 ? safeWidths : [image.default.width];

const fallbackFormat = image.default.format === 'png' ? 'png' : 'jpeg';

// Explicit aspect-ratio, not just width/height attributes. Browsers treat
// width/height attributes as low-priority presentational hints, and in some
// layout contexts they don't reliably fall back to the image's real
// intrinsic ratio — the box can end up an arbitrary, wrong size. Setting
// aspect-ratio directly from the actual pixel dimensions avoids that.
const aspectRatio = `${image.default.width} / ${image.default.height}`;

const fixedWidth = fixedHeight
  ? Math.round(fixedHeight * (image.default.width / image.default.height))
  : undefined;

// For the fixed-height case, width/height are also set inline (not just as
// HTML attributes) because inline style is the one thing guaranteed to beat
// every external stylesheet rule in the cascade — including this project's
// own global `img { height: auto }` reset, which would otherwise silently
// win over the plain width/height attributes and shrink the image back down.
// max-width: none is needed too, separately — global.css's `max-width: 100%`
// isn't overridden by setting `width`, since max-width and width are
// different properties and max-width always wins when they'd conflict.
---

{
  fixedHeight ? (
    <Picture
      src={image.default}
      alt={alt}
      class={className}
      width={fixedWidth}
      height={fixedHeight}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat={fallbackFormat}
      loading={loading}
      fetchpriority={fetchpriority}
      style={`aspect-ratio: ${aspectRatio}; width: ${fixedWidth}px; height: ${fixedHeight}px; max-width: none;`}
    />
  ) : (
    <Picture
      src={image.default}
      alt={alt}
      class={className}
      widths={effectiveWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat={fallbackFormat}
      loading={loading}
      fetchpriority={fetchpriority}
      style={`aspect-ratio: ${aspectRatio};`}
    />
  )
}
